<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learning.backend_playground.mapper.NoteMapper">
    <select id="selectAll" resultType="com.learning.backend_playground.entity.Note">
        SELECT id, title, content, created_at FROM note ORDER BY id
    </select>

    <select id="selectById" resultType="com.learning.backend_playground.entity.Note">
        SELECT id, title, content, created_at
        FROM note
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO note (title, content)
        VALUES (#{title}, #{content})
    </insert>
</mapper>

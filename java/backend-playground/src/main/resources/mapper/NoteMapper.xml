<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.learning.backend_playground.mapper.NoteMapper">
    <select id="selectAll" resultType="com.learning.backend_playground.entity.Note">
        SELECT id, title, content, created_at, tag FROM note ORDER BY id
    </select>

    <select id="countAll" resultType="int">
        SELECT COUNT(*) FROM note
    </select>

    <select id="selectPage" resultType="com.learning.backend_playground.entity.Note">
        SELECT id, title, content, created_at, tag
        FROM note
        ORDER BY id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectById" resultType="com.learning.backend_playground.entity.Note">
        SELECT id, title, content, created_at, tag
        FROM note
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO note (title, content)
        VALUES (#{title}, #{content})
    </insert>

    <select id="selectByKeyword" resultType="com.learning.backend_playground.entity.Note">
        SELECT id, title, content, created_at, tag
        FROM note
        <where>
            <if test="keyword != null and keyword != ''">
                AND title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY id
    </select>

    <update id="updateTagById">
        UPDATE note SET tag = #{tag} WHERE id = #{id}
    </update>


    <sql id="noteKeywordWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                AND title LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </sql>

    <select id="countByKeyword" resultType="int">
        SELECT COUNT(*) FROM note
        <include refid="noteKeywordWhere"/>
    </select>

    <select id="selectPageByKeyword" resultType="com.learning.backend_playground.entity.Note">
        SELECT id, title, content, created_at, tag
        FROM note
        <include refid="noteKeywordWhere"/>
        ORDER BY id
        LIMIT #{limit} OFFSET #{offset}
    </select>    
</mapper>
